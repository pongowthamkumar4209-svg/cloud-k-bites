# Copy this to .env and fill in your real values
# NEVER commit .env to git

# ── Supabase ─────────────────────────────────────────────────────────────────
# Get from: supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL="https://your_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_anon_public_key"

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
# Test:  rzp_test_xxxxxxxxxxxx
# Live:  rzp_live_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"

# ── Admin ─────────────────────────────────────────────────────────────────────
VITE_ADMIN_PASSWORD="cloudk2026"
